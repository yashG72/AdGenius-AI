# Copy this file to `.env` and adjust values. `.env` is git-ignored.

# ---------- Application ----------
APP_NAME="AdGenius AI"
ENVIRONMENT=local            # local | test | staging | production
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# ---------- Security (phase 12) ----------
# Peers whose X-Forwarded-For header is believed (IPs or CIDRs): the Next.js server
# locally, your load balancer in deployment.
TRUSTED_PROXIES=["127.0.0.1", "::1"]
# Turn on only when the API is served over HTTPS.
HSTS_ENABLED=false
RATE_LIMIT_ENABLED=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
MAX_JSON_BODY_KB=1024

# ---------- PostgreSQL ----------
# Use a dedicated non-superuser role that owns both databases.
DATABASE_URL=postgresql+asyncpg://adgenius:CHANGE_ME@localhost:5432/adgenius
# Wiped and re-migrated on every test run - never point this at real data.
TEST_DATABASE_URL=postgresql+asyncpg://adgenius:CHANGE_ME@localhost:5432/adgenius_test
DATABASE_ECHO=false

# ---------- Auth ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- Redis + background jobs ----------
# Local dev: Redis 8 as the Celery broker, separate worker processes.
REDIS_URL=redis://127.0.0.1:6379/0
TASK_MODE=celery
# Free hosting (see docs/DEPLOYMENT.md): REDIS_URL= (empty) and TASK_MODE=inline -
# jobs run inside the API process; caches and rate limits stay in memory.
# INLINE_MAX_CONCURRENT_CAMPAIGNS=1

# ---------- Qdrant ----------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=brand_documents
# QDRANT_API_KEY=            # only for Qdrant Cloud

# ---------- Embeddings (local & free via FastEmbed) ----------
DENSE_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-small-en
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
# EMBEDDING_PROVIDER=local     # 'gemini' = dense vectors from the Gemini API (small hosts)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_DIM=768
# Switching provider changes the vectors: use a new QDRANT_COLLECTION and re-upload.

# ---------- Documents ----------
STORAGE_DIR=storage/documents
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# ---------- LLM: Google Gemini (free key at https://aistudio.google.com/apikey) ----------
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=120

# ---------- Live web research: Tavily (free key at https://tavily.com) ----------
TAVILY_API_KEY=
WEB_SEARCH_DEPTH=basic
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_CACHE_TTL_SECONDS=86400
WEB_RESEARCH_MAX_QUERIES=6

# ---------- Multi-agent workflow ----------
AGENT_APPROVAL_THRESHOLD=80
AGENT_MAX_REVISIONS=2
AGENT_MAX_CONCEPT_ROUNDS=3

# ---------- Optional LangSmith tracing (https://smith.langchain.com) ----------
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=adgenius

# ---------- RAG ----------
# Off by default - see docs/RAG_EVALUATION.md (no quality gain on our eval set, +0.6 s/query)
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-12-v2
RAG_RERANK_ENABLED=false
RAG_QUERY_REWRITE_ENABLED=true
RAG_MAX_QUERY_VARIANTS=3
RAG_CANDIDATES_PER_SEARCH=20
RAG_RERANK_CANDIDATES=20
RAG_TOP_K=8
RAG_CONTEXT_CHUNKS=5
RAG_CONTEXT_TOKEN_BUDGET=4000
