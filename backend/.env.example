# Copy this file to `.env` and adjust values. `.env` is git-ignored.

# ---------- Application ----------
APP_NAME="AdGenius AI"
ENVIRONMENT=local            # local | test | staging | production
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# ---------- PostgreSQL ----------
# Use a dedicated non-superuser role that owns both databases.
DATABASE_URL=postgresql+asyncpg://adgenius:CHANGE_ME@localhost:5432/adgenius
# Wiped and re-migrated on every test run - never point this at real data.
TEST_DATABASE_URL=postgresql+asyncpg://adgenius:CHANGE_ME@localhost:5432/adgenius_test
DATABASE_ECHO=false

# ---------- Auth ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- Redis (Memurai on Windows) - Celery broker ----------
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- Qdrant ----------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=brand_documents
# QDRANT_API_KEY=            # only for Qdrant Cloud

# ---------- Embeddings (local & free via FastEmbed) ----------
DENSE_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-small-en
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# ---------- Documents ----------
STORAGE_DIR=storage/documents
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# LLM keys (Gemini) are added in phase 5.
